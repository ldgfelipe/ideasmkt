rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Leads: cualquiera puede crear (formulario público), solo autenticados pueden leer
    match /leads/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Eventos (p. ej. clics en los botones de llamada): se crean desde las
    // landing públicas, solo los autenticados los pueden consultar.
    match /eventos/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Posts del blog: lectura pública, escritura solo autenticados
    match /posts/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Usuarios: el propio usuario y admins pueden leer/escribir
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
