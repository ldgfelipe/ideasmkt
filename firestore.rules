rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────── Helpers de rol ───────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    // Rol guardado en el perfil del usuario (users/{uid}.role).
    function role() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : '';
    }

    function isAdmin() {
      return signedIn() && role() == 'admin';
    }

    // ────────────────────────────── Leads ─────────────────────────────────
    // El formulario público puede crear; solo los administradores leen.
    match /leads/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ───────────────────────────── Mensajes ───────────────────────────────
    // Formulario de /contact. El público crea; solo los administradores leen,
    // marcan como leído/respondido o borran. Se validan los campos mínimos.
    match /mensajes/{id} {
      allow create: if request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000;
      allow read, update, delete: if isAdmin();
    }

    // ────────────────────────────── Eventos ───────────────────────────────
    // Analítica de las landings (/lp) y tarjetas digitales (/td): visitas y
    // clics. Se crean desde el navegador del visitante, así que se validan
    // los campos mínimos para que no sirvan como almacenamiento arbitrario.
    match /eventos/{id} {
      allow create: if request.resource.data.type in ['page_view', 'click', 'call_click']
        && request.resource.data.pageId is string
        && request.resource.data.pageId.size() <= 100
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10;
      allow read, update, delete: if isAdmin();
    }

    // ─────────────────────── Páginas registradas ──────────────────────────
    // Catálogo de landings y tarjetas digitales del panel. Solo el admin.
    match /paginas/{id} {
      allow read, write: if isAdmin();
    }

    // ───────────────────────────── Clientes ───────────────────────────────
    match /clientes/{id} {
      allow read, write: if isAdmin();
    }

    // ─────────────────────────── Blog (posts) ─────────────────────────────
    match /posts/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ───────────────────────────── Usuarios ───────────────────────────────
    // Cada quien ve y edita su perfil; solo un admin cambia roles o borra.
    // Al registrarse el rol queda forzado a "cliente" (nadie se hace admin).
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'cliente';
      allow update: if isAdmin()
        || (signedIn()
            && request.auth.uid == userId
            && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }
  }
}
