---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { COMPANY_INFO, SERVICES } from '../lib/constants';

interface Props {
  title?: string;
  description?: string;
  /** Ruta o URL de la imagen para redes sociales (Open Graph). */
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  author?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'IdeasMKT - Agencia de Marketing Digital',
  description = 'Estrategias de marketing digital que impulsan tu negocio al siguiente nivel. SEO, publicidad pagada, redes sociales y más.',
  image = '/og-default.jpg',
  type = 'website',
  publishedTime,
  author,
  noindex = false,
  jsonLd
} = Astro.props;

const site = Astro.site ?? new URL('https://ideasmkt.web.app');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;

const siteSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': new URL('/#organizacion', site).href,
    name: COMPANY_INFO.name,
    url: site.href,
    logo: { '@type': 'ImageObject', url: new URL('/og-default.jpg', site).href },
    image: new URL('/og-default.jpg', site).href,
    email: COMPANY_INFO.email,
    telephone: COMPANY_INFO.phone,
    description: COMPANY_INFO.description,
    areaServed: [
      { '@type': 'Country', name: 'México' },
      { '@type': 'Place', name: 'Latinoamérica' }
    ],
    knowsLanguage: ['es'],
    contactPoint: [
      {
        '@type': 'ContactPoint',
        contactType: 'Atención a clientes',
        telephone: COMPANY_INFO.phone,
        email: COMPANY_INFO.email,
        availableLanguage: ['es'],
        url: `https://wa.me/${COMPANY_INFO.whatsapp}`
      }
    ],
    knowsAbout: SERVICES.map((s) => s.title),
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Servicios de marketing digital',
      itemListElement: SERVICES.map((s) => ({
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: s.title,
          description: s.description,
          serviceType: s.subtitle,
          url: new URL(`/services/#${s.id}`, site).href
        }
      }))
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: COMPANY_INFO.name,
    url: site.href,
    inLanguage: 'es',
    publisher: { '@id': new URL('/#organizacion', site).href }
  }
];

const schemas = jsonLd ? [...siteSchema, ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])] : siteSchema;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#7c3aed" />
    <link rel="canonical" href={canonical} />
    <meta
      name="robots"
      content={noindex
        ? 'noindex, nofollow'
        : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="IdeasMKT" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {author && <meta property="article:author" content={author} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    {
      schemas.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
  </head>
  <body class="font-inter bg-white text-gray-900 antialiased">
    <Header />
    <main class="min-h-screen">
      <slot />
    </main>
    <Footer />
  </body>
</html>
