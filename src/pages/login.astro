---
import AuthLayout from '../layouts/AuthLayout.astro';
import LoginForm from '../components/LoginForm';
---

<AuthLayout title="Acceso - IdeasMKT">
  <div class="min-h-screen flex items-center justify-center py-12">
    <div class="max-w-md w-full mx-4">
      <div class="text-center mb-8">
        <span class="text-3xl font-bold gradient-text">IdeasMKT</span>
        <h1 class="text-2xl font-bold text-gray-900 mt-2">Iniciar sesión</h1>
        <p class="text-gray-600 mt-1">Accede con tu cuenta. Los clientes ven la información de sus páginas.</p>
      </div>
      <LoginForm client:load />
    </div>
  </div>
</AuthLayout>
