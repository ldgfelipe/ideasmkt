---
// Tarjeta digital Zabdín Studio — Ruta: /td/zabdi-studio
// IMPORTANTE: importar global.css o Tailwind no aplica ningún estilo.
import '../../styles/global.css';
import PriceCatalog from '../../components/zabdin/PriceCatalog';

const links = {
  agenda: 'https://wa.link/2rv9kq', // Agenda tu cita (WhatsApp)
  ubicacion: 'https://www.google.com/maps/search/?api=1&query=Zabd%C3%ADn+Studio',
  facebook: 'https://www.facebook.com/zbstudiopuebla/',
  instagram: 'https://www.instagram.com/zabdistudio_/',
  // PDF originales (Firebase Storage). Se abren en ventana/pestaña nueva.
  pdfQuienes:
    'https://firebasestorage.googleapis.com/v0/b/ideasmkt-53500.firebasestorage.app/o/QUIENES%20SOMOS.pdf?alt=media&token=1d342aaf-fc06-4af1-ac3a-4b84092f9180',
  pdfPrecios:
    'https://firebasestorage.googleapis.com/v0/b/ideasmkt-53500.firebasestorage.app/o/LISTA%20DE%20PRECIOS%20RGB%202026.pdf?alt=media&token=780182d1-7860-4319-9fc7-66ecb7bc34dc'
};

// Icono (SVG) que acompaña a los enlaces "Ver PDF".
const pdfIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M9 15h6"/><path d="M9 18h4"/></svg>`;

// Botones del menú inicial: `href` navega; "Quiénes Somos" y "Catálogo"
// abren directamente el PDF original en una pestaña nueva.
const menuItems = [
  { label: 'Quiénes Somos', href: links.pdfQuienes, external: true },
  { label: 'Catálogo', href: links.pdfPrecios, external: true },
  { label: 'Agenda tu cita', href: links.agenda, external: true },
  { label: 'Ubicación', href: links.ubicacion, external: true }
];

const socials = [
  { img: '/zabdin/facebook.webp', alt: 'Facebook', href: links.facebook },
  { img: '/zabdin/instagram.webp', alt: 'Instagram', href: links.instagram }
];

// Contenido de "Quiénes Somos" (extraído de QUIENES SOMOS.pdf)
const quienes = {
  intro:
    'Zabdi Studio, somos un concepto creado para cubrir las necesidades de nuestros clientes cuidando cada detalle de su belleza integral. Nos especializamos principalmente en:',
  specialties: [
    'Manos',
    'Pies',
    'Cabello',
    'Lash lifting',
    'Extensión de pestañas',
    'Alisados marroquís / Alisados Alemán / Queratinas brasileñas'
  ],
  blocks: [
    {
      label: 'Nuestra misión',
      text: ' en Zabdi Studio es realzar la belleza natural de nuestros clientes a través de servicios de alta calidad en el cuidado físico de nuestro cabello, rostro, manos y pies.'
    },
    {
      label: 'Nuestro compromiso',
      text: ' es brindar una experiencia excepcional, ofreciéndoles un valor agregado a su presencia, basado en la atención personalizada, creatividad, frescura y excelencia en cada uno de nuestros servicios, con la finalidad de garantizar la satisfacción total de nuestros clientes.'
    },
    {
      label: 'La visión',
      text: ' de Zabdi Studio es ser reconocidos como el referente en servicios de belleza en nuestra comunidad, destacándonos por la alta calidad de nuestros servicios, la innovación constante y la satisfacción total de nuestros clientes, buscamos expandir nuestra presencia y ',
      emphasis: 'convertirnos en un destino preferido para quienes buscan cuidado y belleza integral.'
    }
  ],
  values: [
    {
      name: 'Calidad humana:',
      text: ' Priorizamos las relaciones auténticas y el trato digno con nuestros clientes, nuestro equipo de trabajo se dedica a escuchar, comprender y cuidar de cada persona que entra en Zabdi Studio, creando un ambiente cálido y acogedor en donde todos se sientan valorados y respetados.'
    },
    {
      name: 'Excelencia:',
      text: ' Nos esforzamos por brindar servicios de alta calidad y resultados excepcionales en todo lo que hacemos, manteniendo un enfoque constante en la mejora continua.'
    },
    {
      name: 'Creatividad:',
      text: ' Buscamos la innovación y la originalidad en nuestros servicios, manteniendo la vanguardia de las tendencias en el mundo de la belleza.'
    },
    {
      name: 'Pasión:',
      text: ' Nos caracterizamos por la dedicación en aquello que amamos, buscamos la excelencia en lo que hacemos, es nuestro motor que alimenta la creatividad, la innovación y el compromiso que tenemos llevando resultados satisfactorios tanto a nivel personal como profesional.'
    },
    {
      name: 'Sustentabilidad:',
      text: ' Nos comprometemos a utilizar prácticas y productos sostenibles, cuidando no solo de nuestros clientes, sino también del medio ambiente.'
    },
    {
      name: 'Empoderamiento:',
      text: ' Fomentamos la confianza y autoexpresión de nuestros clientes, ayudándolos a sentirse bien con su apariencia y resaltar su belleza única y especial.'
    }
  ]
};
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta
      name="description"
      content="Zabdín Studio — Tarjeta digital. Quiénes somos, catálogo con lista de precios 2026, agenda tu cita y ubicación."
    />
    <title>Zabdín Studio · Tarjeta Digital</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Mulish:ital,wght@0,300..800;1,300..800&family=Questrial&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        --zabdi-pink: #cf3080;
        --zabdi-pink-dark: #b02870;
      }

      .td-display {
        font-family: 'Century Gothic', 'Questrial', ui-sans-serif, system-ui, sans-serif;
      }

      .td-body {
        font-family: 'Mulish', ui-sans-serif, system-ui, sans-serif;
      }

      /* Serif itálica (Times) — igual que en el PDF para los rótulos de los
         valores y la frase destacada de la visión. */
      .td-serif {
        font-family: 'Times New Roman', Times, Georgia, serif;
        font-style: italic;
      }

      /* ───────── Vista "Quiénes Somos": recreación del PDF de Illustrator ───────── */
      .td-quienes {
        position: relative;
        margin: 0 auto;
        width: 100%;
        max-width: 640px;
        padding: 2.25rem 11.5% 5.5rem;
      }

      /* Adorno floral (melocotón/lavanda) de la esquina superior derecha. */
      .td-quienes__deco {
        position: absolute;
        top: 2.5rem;
        right: 11.5%;
        width: 23%;
        max-width: 160px;
        pointer-events: none;
      }

      .td-quienes__deco img {
        display: block;
        width: 100%;
        height: auto;
      }

      .td-quienes__title {
        margin-top: 8.5rem;
        font-family: 'Century Gothic', 'Questrial', ui-sans-serif, system-ui, sans-serif;
        font-size: clamp(1.75rem, 5.4vw, 2.4rem);
        font-weight: 400;
        line-height: 1.05;
        letter-spacing: 0.01em;
        color: #050505;
        text-transform: uppercase;
      }

      .td-quienes__intro,
      .td-quienes__list,
      .td-quienes__blocks,
      .td-quienes__values {
        font-family: 'Century Gothic', 'Questrial', ui-sans-serif, system-ui, sans-serif;
        font-size: clamp(1rem, 2.4vw, 1.06rem);
        line-height: 1.7;
        color: #545c5c;
      }

      .td-quienes__intro {
        margin-top: 1.75rem;
      }

      .td-quienes__list {
        margin-top: 1.1rem;
        padding-left: 0;
        list-style: none;
      }

      .td-quienes__list li {
        position: relative;
        padding-left: 1.15rem;
      }

      .td-quienes__list li::before {
        content: '•';
        position: absolute;
        left: 0.2rem;
      }

      .td-quienes__blocks {
        margin-top: 2.25rem;
      }

      .td-quienes__blocks p {
        margin-top: 1.15rem;
      }

      .td-quienes__blocks p:first-child {
        margin-top: 0;
      }

      .td-quienes__label {
        font-weight: 700;
        color: #3f4747;
      }

      .td-quienes__values-title {
        margin-top: 2.75rem;
        font-family: 'Century Gothic', 'Questrial', ui-sans-serif, system-ui, sans-serif;
        font-size: clamp(1.4rem, 3.6vw, 1.7rem);
        font-weight: 700;
        text-align: right;
        color: #050505;
      }

      .td-quienes__values {
        margin-top: 1.5rem;
      }

      .td-quienes__values p {
        margin-top: 1.1rem;
      }

      .td-quienes__values p:first-child {
        margin-top: 0;
      }

      .td-quienes__value-name {
        font-size: 1.12rem;
        color: #ac3c7c;
      }

      .td-quienes__foot {
        display: flex;
        justify-content: center;
        margin-top: 3.25rem;
      }

      /* Botones-píldora del menú: mismas proporciones (552x86) y misma tipografía. */
      .td-btn {
        position: relative;
        display: flex;
        width: 60%;
        max-width: 260px;
        aspect-ratio: 552 / 86;
        align-items: center;
        justify-content: center;
        border: 0;
        border-radius: 9999px;
        background: var(--zabdi-pink);
        color: #fff;
        text-decoration: none;
        cursor: pointer;
        padding: 0;
        overflow: hidden;
        container-type: inline-size;
        transition: transform 0.2s ease, filter 0.2s ease, box-shadow 0.2s ease;
      }

      .td-btn:hover {
        transform: scale(1.04);
        filter: brightness(1.04);
        box-shadow: 0 8px 20px -8px rgba(207, 48, 128, 0.6);
      }

      .td-btn:active {
        transform: scale(0.97);
      }

      .td-btn:focus-visible {
        outline: 2px solid var(--zabdi-pink);
        outline-offset: 3px;
      }

      .td-btn-label {
        font-family: 'Century Gothic', 'Questrial', ui-sans-serif, system-ui, sans-serif;
        font-size: 8.4cqi;
        line-height: 1;
        letter-spacing: 0.02em;
        white-space: nowrap;
      }

      /* Botón "volver al menú". */
      .td-back {
        display: inline-flex;
        min-height: 48px;
        align-items: center;
        gap: 0.5rem;
        border: 1px solid var(--zabdi-pink);
        border-radius: 9999px;
        background: #fff;
        padding: 0.7rem 1.4rem;
        color: var(--zabdi-pink);
        font-family: 'Century Gothic', 'Questrial', ui-sans-serif, system-ui, sans-serif;
        font-size: 1.05rem;
        line-height: 1;
        cursor: pointer;
        transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
      }

      .td-back:hover {
        background: var(--zabdi-pink);
        color: #fff;
        transform: translateX(-2px);
      }

      /* Enlace-píldora "Ver PDF": abre el documento original en ventana nueva. */
      .td-pdf {
        display: inline-flex;
        min-height: 48px;
        align-items: center;
        gap: 0.55rem;
        border: 1px solid var(--zabdi-pink);
        border-radius: 9999px;
        background: var(--zabdi-pink);
        padding: 0.7rem 1.4rem;
        color: #fff;
        font-family: 'Century Gothic', 'Questrial', ui-sans-serif, system-ui, sans-serif;
        font-size: 1.05rem;
        line-height: 1;
        text-decoration: none;
        cursor: pointer;
        transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
      }

      .td-pdf:hover {
        background: #fff;
        color: var(--zabdi-pink);
        transform: translateY(-2px);
      }

      .td-pdf svg {
        width: 1.15rem;
        height: 1.15rem;
        flex: none;
      }

      /* Dos acciones centradas (PDF + Volver al menú). */
      .td-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
      }

      /* ────────────── Animación de entrada elegante ────────────── */
      .td-menu-inner {
        position: relative;
      }

      /* Reveal escalonado: logo → eslogan → botones. */
      .reveal {
        opacity: 0;
        transform: translateY(26px) scale(0.965);
        filter: blur(8px);
        transition:
          opacity 1.1s cubic-bezier(0.22, 1, 0.36, 1),
          transform 1.1s cubic-bezier(0.22, 1, 0.36, 1),
          filter 1s ease;
        transition-delay: var(--d, 0ms);
        will-change: opacity, transform, filter;
      }

      .reveal.is-in {
        opacity: 1;
        transform: none;
        filter: none;
      }

      /* Destello de luz que recorre el logo (pausado y sutil). */
      .td-logo-wrap {
        position: relative;
        display: inline-block;
        line-height: 0;
        z-index: 2;
      }

      .td-logo-wrap::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(
          115deg,
          transparent 42%,
          rgba(255, 255, 255, 0.85) 50%,
          transparent 58%
        );
        background-size: 260% 100%;
        background-repeat: no-repeat;
        background-position: 130% 0;
        -webkit-mask: url('/zabdin/logo-zabdin.webp') center / contain no-repeat;
        mask: url('/zabdin/logo-zabdin.webp') center / contain no-repeat;
        animation: td-sheen 10s ease-in-out 3s infinite;
        pointer-events: none;
      }

      @keyframes td-sheen {
        0% {
          background-position: 130% 0;
        }
        12%,
        100% {
          background-position: -130% 0;
        }
      }

      .td-btn {
        z-index: 2;
      }

      /* Destello que recorre cada botón al pasar el mouse. */
      .td-btn::after {
        content: '';
        position: absolute;
        top: -10%;
        left: 0;
        width: 45%;
        height: 120%;
        background: linear-gradient(
          115deg,
          transparent 0%,
          rgba(255, 255, 255, 0.7) 50%,
          transparent 100%
        );
        transform: translateX(-220%) skewX(-20deg);
        opacity: 0;
        pointer-events: none;
      }

      .td-btn:hover::after,
      .td-btn:focus-visible::after {
        animation: td-btn-shine 0.85s ease;
      }

      @keyframes td-btn-shine {
        0% {
          transform: translateX(-220%) skewX(-20deg);
          opacity: 0;
        }
        25% {
          opacity: 1;
        }
        100% {
          transform: translateX(340%) skewX(-20deg);
          opacity: 0;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .reveal {
          opacity: 1;
          transform: none;
          filter: none;
          transition: none;
        }

        .td-logo-wrap::after,
        .td-btn::after {
          animation: none;
          opacity: 0;
        }
      }
    </style>
  </head>

  <body class="td-body m-0 antialiased">
    <!-- ═══════════════════════ VISTA: MENÚ INICIAL ═══════════════════════ -->
    <main
      data-view-panel="menu"
      class="flex min-h-dvh w-full flex-col bg-cover bg-center bg-no-repeat"
      style="background-image: url('/zabdin/fondo-tarjeta.webp');"
    >
      <div class="h-[3dvh] min-h-[16px] w-full bg-[#a2a19f]"></div>

      <div
        class="td-menu-inner mx-auto flex w-full max-w-[1050px] flex-col items-center px-4 pt-6 pb-10"
      >
        <div class="td-logo-wrap reveal w-[85%] max-w-[440px]" style="--d:100ms">
          <img
            src="/zabdin/logo-zabdin.webp"
            alt="Zabdín Studio"
            class="w-full"
            loading="eager"
          />
        </div>

        <img
          src="/zabdin/donde-comienza.webp"
          alt="Donde la magia comienza"
          class="reveal mt-4 w-[68%] max-w-[340px]"
          style="--d:450ms"
          loading="eager"
        />

        <div class="mt-8 flex w-full flex-col items-center gap-5 sm:gap-6">
          {
            menuItems.map((item, i) => (
              <div class="reveal flex w-full justify-center" style={`--d:${820 + i * 160}ms`}>
                <a
                  class="td-btn"
                  href={item.href}
                  target={item.external ? '_blank' : undefined}
                  rel={item.external ? 'noopener noreferrer' : undefined}
                  aria-label={item.label}
                >
                  <span class="td-btn-label">{item.label}</span>
                </a>
              </div>
            ))
          }
        </div>
      </div>

      <footer class="reveal mt-auto flex min-h-[44px] w-full items-center justify-center gap-7 bg-[#a2a19f] py-2" style="--d:1500ms">
        {
          socials.map((s) => (
            <a
              href={s.href}
              target={s.href.startsWith('http') ? '_blank' : undefined}
              rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              aria-label={s.alt}
              class="flex h-12 w-12 items-center justify-center transition-transform duration-200 hover:scale-110"
            >
              <img src={s.img} alt={s.alt} class="h-9 w-9 sm:h-10 sm:w-10" loading="lazy" />
            </a>
          ))
        }
      </footer>
    </main>

    <!-- ═══════════════════════ VISTA: QUIÉNES SOMOS ═══════════════════════ -->
    <!-- Recreación del diseño original en PDF (Adobe Illustrator): fondo blanco,
         columna tipo teléfono, tipografía Century Gothic + Times itálica y
         rótulos de valores en rosa, con adorno floral arriba a la derecha. -->
    <section data-view-panel="quienes" style="display: none;" class="min-h-dvh w-full bg-white">
      <div class="td-quienes">
        <div class="td-quienes__deco" aria-hidden="true">
          <img src="/zabdin/quienes-deco.png" alt="" decoding="async" />
        </div>

        <button type="button" class="td-back td-quienes__back" data-back>
          <span aria-hidden="true">←</span> Volver al menú
        </button>

        <h2 class="td-quienes__title">Quienes Somos</h2>

        <p class="td-quienes__intro">{quienes.intro}</p>

        <ul class="td-quienes__list">
          {quienes.specialties.map((s) => <li>{s}</li>)}
        </ul>

        <div class="td-quienes__blocks">
          {
            quienes.blocks.map((block) => (
              <p>
                <strong class="td-quienes__label">{block.label}</strong>
                {block.text}
                {block.emphasis && <em class="td-serif">{block.emphasis}</em>}
              </p>
            ))
          }
        </div>

        <h3 class="td-quienes__values-title">Nuestros Valores</h3>

        <div class="td-quienes__values">
          {
            quienes.values.map((value) => (
              <p>
                <span class="td-serif td-quienes__value-name">{value.name}</span>
                {value.text}
              </p>
            ))
          }
        </div>

        <div class="td-quienes__foot">
          <div class="td-actions">
            <a
              class="td-pdf"
              href={links.pdfQuienes}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Ver el PDF original de Quiénes Somos en una ventana nueva"
            >
              <Fragment set:html={pdfIcon} />
              <span>Ver PDF</span>
            </a>
            <button type="button" class="td-back" data-back>
              <span aria-hidden="true">←</span> Volver al menú
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════ VISTA: CATÁLOGO & PRECIOS ═══════════════════════ -->
    <section
      data-view-panel="catalogo"
      style="display: none;"
      class="min-h-dvh w-full bg-[#f6ece2] px-4 pt-5 pb-16 sm:px-6"
    >
      <div class="mx-auto max-w-[760px]">
        <button type="button" class="td-back" data-back>
          <span aria-hidden="true">←</span> Volver al menú
        </button>

        <img
          src="/zabdin/precios-banner.webp"
          alt=""
          width="750"
          height="470"
          class="mx-auto mt-4 w-full max-w-[560px] select-none"
          draggable="false"
        />

        <header class="mt-6 mb-7 text-center">
          <h2
            class="td-display text-[1.7rem] font-bold uppercase leading-tight tracking-[0.12em] text-[#7b5b46] sm:text-4xl"
          >
            Lista de Precios
          </h2>
          <p class="td-display mt-1.5 text-sm font-bold uppercase tracking-[0.42em] text-[#cf3080]">
            2026
          </p>
          <p class="mx-auto mt-3 max-w-lg text-[1rem] text-[#8c8075]">
            Busca el servicio que necesitas o filtra por categoría. Encuentra tu
            tratamiento ideal en segundos.
          </p>

          <div class="td-actions mt-5">
            <a
              class="td-pdf"
              href={links.pdfPrecios}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Ver la lista de precios completa en PDF (se abre en una ventana nueva)"
            >
              <Fragment set:html={pdfIcon} />
              <span>Ver PDF</span>
            </a>
          </div>
        </header>

        <PriceCatalog client:load />

        <div class="td-actions mt-12">
          <a
            class="td-pdf"
            href={links.pdfPrecios}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Ver la lista de precios completa en PDF (se abre en una ventana nueva)"
          >
            <Fragment set:html={pdfIcon} />
            <span>Ver PDF</span>
          </a>
          <button type="button" class="td-back" data-back>
            <span aria-hidden="true">←</span> Volver al menú
          </button>
        </div>
      </div>
    </section>

    <script is:inline>
      (function () {
        var panels = document.querySelectorAll('[data-view-panel]');
        var menu = document.querySelector('[data-view-panel="menu"]');

        function reveal(scope) {
          if (!scope) return;
          scope.querySelectorAll('.reveal').forEach(function (el) {
            el.classList.add('is-in');
          });
        }

        // Vista actual según el hash de la URL (#catalogo / #quienes).
        function currentView() {
          var h = (location.hash || '').replace('#', '');
          return h === 'quienes' || h === 'catalogo' ? h : 'menu';
        }

        function render() {
          var view = currentView();
          panels.forEach(function (panel) {
            panel.style.display =
              panel.getAttribute('data-view-panel') === view ? '' : 'none';
          });
          window.scrollTo(0, 0);
          if (view === 'menu' && menu) reveal(menu);
        }

        // Entrada escalonada cuando el menú está en pantalla.
        if (menu) {
          if ('IntersectionObserver' in window) {
            var io = new IntersectionObserver(
              function (entries) {
                entries.forEach(function (entry) {
                  if (entry.isIntersecting) {
                    reveal(menu);
                    io.disconnect();
                  }
                });
              },
              { threshold: 0.12 }
            );
            io.observe(menu);
          }
          // Respaldo: revelar igualmente tras un instante.
          window.setTimeout(function () {
            reveal(menu);
          }, 350);
        }

        // Estado inicial: recuerda si abrimos directo en una vista interna.
        history.replaceState({ view: currentView(), fromCard: false }, '');
        render();

        // Nota: el menú abre los PDFs en pestaña nueva, así que ya no hay botones
        // [data-view]. Las vistas siguen siendo navegables por hash (#quienes /
        // #catalogo) y se cambian aquí al cambiar la URL.
        // "Volver al menú" dentro de esas vistas: limpia el hash.
        document.querySelectorAll('[data-back]').forEach(function (el) {
          el.addEventListener('click', function () {
            location.hash = '';
            render();
          });
        });

        window.addEventListener('popstate', render);
        window.addEventListener('hashchange', render);
      })();
    </script>
  </body>
</html>
