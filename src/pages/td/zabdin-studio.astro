---
// Tarjeta digital Zabdín Studio
// Ruta: /td/zabdin-studio
// Las descripciones son PROVISIONALES y deben reemplazarse con el texto real del PDF.
const buttons = [
  {
    id: 'quienes-somos',
    img: '/zabdin/btn_quienes_somos.webp',
    alt: 'Quiénes Somos',
    title: 'Quiénes Somos',
    // TODO: reemplazar con la descripción real del PDF
    description:
      'Zabdín Studio es un espacio creativo donde la magia comienza. [TEXTO PROVISIONAL — reemplazar con el del PDF]'
  },
  {
    id: 'catalogo',
    img: '/zabdin/btn_catalogo.webp',
    alt: 'Catálogo',
    title: 'Catálogo',
    // TODO: reemplazar con la descripción real del PDF
    description:
      'Explora nuestro catálogo de productos y servicios diseñados para ti. [TEXTO PROVISIONAL — reemplazar con el del PDF]'
  },
  {
    id: 'agenda-tu-cita',
    img: '/zabdin/btn_agenda_tu_cita.webp',
    alt: 'Agenda tu cita',
    title: 'Agenda tu cita',
    // TODO: reemplazar con la descripción real del PDF
    description:
      'Agenda tu cita y conecta con nuestro equipo. [TEXTO PROVISIONAL — reemplazar con el del PDF]'
  }
];

const socials = [
  { id: 'facebook', img: '/zabdin/facebook.webp', alt: 'Facebook', href: '#' },
  { id: 'instagram', img: '/zabdin/instagram.webp', alt: 'Instagram', href: '#' }
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Zabdín Studio · Tarjeta Digital</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-inter m-0 antialiased">
    <main
      class="min-h-screen w-full bg-cover bg-center bg-no-repeat flex items-center justify-center p-4"
      style={`background-image: linear-gradient(rgba(20,10,40,0.55), rgba(20,10,40,0.55)), url('/zabdin/fondo.webp');`}
    >
      <div class="w-full max-w-md mx-auto">
        <div class="bg-white/95 backdrop-blur-sm rounded-2xl shadow-2xl p-6 md:p-8 text-center">
          <p class="text-sm uppercase tracking-widest text-purple-600 font-semibold mb-1">
            Tarjeta Digital
          </p>
          <h1 class="text-2xl md:text-3xl font-extrabold text-gray-900 mb-6">
            Zabdín Studio
          </h1>

          <img
            src="/zabdin/donde-comienza.webp"
            alt="Donde la magia comienza"
            class="mx-auto mb-8 max-w-[280px] w-full"
            loading="lazy"
          />

          <div class="flex flex-col gap-4 items-center">
            {
              buttons.map((btn) => (
                <button
                  type="button"
                  data-id={btn.id}
                  aria-label={btn.alt}
                  class="td-btn w-full max-w-[300px] transition-transform duration-200 hover:scale-[1.03] focus:outline-none focus:ring-2 focus:ring-purple-500 rounded-xl"
                >
                  <img src={btn.img} alt={btn.alt} class="w-full h-auto" loading="lazy" />
                </button>
              ))
            }
          </div>

          <div
            id="td-panel"
            class="mt-6 rounded-xl bg-purple-50 border border-purple-100 p-5 text-left hidden"
          >
            <h2 id="td-title" class="text-lg font-bold text-purple-700 mb-2"></h2>
            <p id="td-desc" class="text-gray-700 text-sm leading-relaxed"></p>
          </div>

          <div class="flex justify-center gap-6 mt-8">
            {
              socials.map((s) => (
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={s.alt}
                  class="transition-transform duration-200 hover:scale-110"
                >
                  <img src={s.img} alt={s.alt} class="w-10 h-10" loading="lazy" />
                </a>
              ))
            }
          </div>
        </div>

        <p class="text-center text-white/70 text-xs mt-4">
          IdeasMKT · Tarjeta Digital
        </p>
      </div>
    </main>

    <script is:inline define:vars={{ buttons }}>
      const panel = document.getElementById('td-panel');
      const titleEl = document.getElementById('td-title');
      const descEl = document.getElementById('td-desc');
      const map = Object.fromEntries(buttons.map((b) => [b.id, b]));

      document.querySelectorAll('.td-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const data = map[btn.getAttribute('data-id')];
          if (!data) return;
          titleEl.textContent = data.title;
          descEl.textContent = data.description;
          panel.classList.remove('hidden');
          panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        });
      });
    </script>
  </body>
</html>
