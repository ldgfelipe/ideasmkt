---
// Tarjeta digital Zabdín Studio — Ruta: /td/zabdin-studio
import '../../styles/global.css';

const links = {
  quienesSomos: '#',
  catalogo: '#',
  agenda: '#',
  ubicacion: 'https://www.google.com/maps/search/?api=1&query=Zabd%C3%ADn+Studio',
  facebook: '#',
  instagram: '#',
  whatsapp: '#'
};

const buttons = [
  { img: '/zabdin/btn_quienes_somos.webp', alt: 'Quiénes Somos', href: links.quienesSomos },
  { img: '/zabdin/btn_catalogo.webp', alt: 'Catálogo', href: links.catalogo },
  { img: '/zabdin/btn_agenda_tu_cita.webp', alt: 'Agenda tu cita', href: links.agenda },
  { img: '/zabdin/btn_ubicacion.webp', alt: 'Ubicación', href: links.ubicacion }
];

const socials = [
  { img: '/zabdin/facebook.webp', alt: 'Facebook', href: links.facebook },
  { img: '/zabdin/instagram.webp', alt: 'Instagram', href: links.instagram },
  { img: '/zabdin/whatsapp.svg', alt: 'WhatsApp', href: links.whatsapp }
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Zabdín Studio · Tarjeta Digital</title>
  </head>
  <body class="m-0 antialiased">
    <main
      class="flex min-h-dvh w-full flex-col bg-cover bg-center bg-no-repeat"
      style="background-image: url('/zabdin/fondo-tarjeta.webp');"
    >
      <div class="h-[3dvh] min-h-[16px] w-full bg-[#a2a19f]"></div>

      <div class="mx-auto flex w-full max-w-[1050px] flex-col items-center px-4 pt-6 pb-10">
        <img
          src="/zabdin/logo-zabdin.webp"
          alt="Zabdín Studio"
          class="w-[85%] max-w-[440px]"
          loading="eager"
        />

        <img
          src="/zabdin/donde-comienza.webp"
          alt="Donde la magia comienza"
          class="mt-4 w-[58%] max-w-[290px]"
          loading="lazy"
        />

        <div class="mt-8 flex w-full flex-col items-center gap-5 sm:gap-6">
          {
            buttons.map((btn) => (
              <a
                href={btn.href}
                target={btn.href.startsWith('http') ? '_blank' : undefined}
                rel={btn.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                aria-label={btn.alt}
                class="block w-[60%] max-w-[260px] transition-transform duration-200 hover:scale-[1.04] focus-visible:scale-[1.04] active:scale-[0.97]"
              >
                <img src={btn.img} alt={btn.alt} class="h-auto w-full" loading="lazy" />
              </a>
            ))
          }
        </div>
      </div>

      <footer class="mt-auto flex min-h-[44px] w-full items-center justify-center gap-7 bg-[#a2a19f] py-2">
        {
          socials.map((s) => (
            <a
              href={s.href}
              target={s.href.startsWith('http') ? '_blank' : undefined}
              rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              aria-label={s.alt}
              class="transition-transform duration-200 hover:scale-110"
            >
              <img src={s.img} alt={s.alt} class="h-7 w-7 sm:h-8 sm:w-8" loading="lazy" />
            </a>
          ))
        }
      </footer>
    </main>
  </body>
</html>
