---
// Landing de campaña Friganta — Ruta: /lp/friganta
//
// Es una página independiente: tiene su propio header y footer (no usa el
// Layout de IdeasMKT) porque va a nombre de Friganta.
// IMPORTANTE: importar global.css o Tailwind no aplica ningún estilo. El HTML
// original traía el CDN de Tailwind; aquí se usa el Tailwind del proyecto.
import '../../styles/global.css';

const title = 'Friganta | Almacenamiento en Frío B2B en Puebla';
const description =
  'Almacenamiento en frío para empresas en México desde Puebla: control de temperatura y humedad, trazabilidad y monitoreo 24/7 para productos perecederos y congelados.';

// Fotos de las instalaciones: son las mismas que usa el sitio de Friganta, pero
// autoalojadas y convertidas a WebP en /public/friganta (no se enlazan desde su
// servidor). Los títulos coinciden con los de su galería.
const gallery = [
  {
    slug: 'fachada-principal-1',
    caption: 'Fachada principal 1',
    alt: 'Fachada principal de las instalaciones de Friganta en Puebla'
  },
  { slug: 'bodegas', caption: 'Bodegas', alt: 'Bodegas frigoríficas de Friganta en Puebla' },
  {
    slug: 'fachada-principal-2',
    caption: 'Fachada principal 2',
    alt: 'Acceso a las instalaciones de Friganta en Puebla'
  },
  {
    slug: 'pasillo-principal',
    caption: 'Pasillo principal',
    alt: 'Pasillo principal entre las cámaras de enfriamiento'
  },
  {
    slug: 'vista-aerea',
    caption: 'Vista aérea',
    alt: 'Vista aérea de las instalaciones de Friganta en Puebla'
  }
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Es la primera imagen visible, así que se precarga -->
    <link rel="preload" as="image" href="/friganta/hero.webp" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="bg-gray-50 text-gray-800 font-sans">
    <!-- Hero Section -->
    <!-- La imagen de fondo es la misma del sitio de Friganta: un banner que se
         difumina hacia abajo, por eso se ve bien sobre el azul de la sección. -->
    <header
      class="relative bg-blue-900 bg-top bg-no-repeat bg-cover text-white py-16"
      style="background-image: url('/friganta/hero.webp');"
    >
      <!-- Degradado para asegurar la lectura del texto sobre la foto -->
      <div
        class="absolute inset-0 bg-gradient-to-r from-blue-950/90 via-blue-950/60 to-blue-900/10"
        aria-hidden="true"
      >
      </div>
      <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <h1
            class="text-4xl md:text-5xl font-bold leading-tight mb-4 [text-shadow:0_2px_10px_rgba(0,0,0,0.4)]"
          >
            Almacenamiento en frío para empresas en México desde Puebla
          </h1>
          <p class="text-lg md:text-xl text-blue-100 mb-8">
            Conserva productos perecederos y congelados en nuestra instalación ubicada en Puebla,
            con control de temperatura y humedad, trazabilidad y monitoreo 24/7 durante su estancia.
          </p>
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
            <a
              href="#cotizador"
              class="inline-block bg-blue-500 hover:bg-blue-600 text-white font-bold py-3 px-8 rounded-lg text-lg transition duration-300 text-center"
            >
              Solicita una cotización
            </a>
            <!-- Botón de llamada: el clic se registra en Firestore (colección eventos) -->
            <a
              href="tel:+522211847798"
              data-call-track="hero"
              class="inline-flex items-center justify-center gap-2 rounded-lg bg-blue-950/50 px-6 py-3 text-lg font-semibold text-white ring-1 ring-white/40 transition hover:bg-blue-950/70"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                ></path>
              </svg>
              Llámanos: +52 221 184 7798
            </a>
          </div>
          <p class="mt-6 text-sm text-blue-200 [text-shadow:0_1px_6px_rgba(0,0,0,0.5)]">
            Instalaciones en Puebla, conectadas con los corredores del centro, Golfo, sur y Pacífico.
          </p>
        </div>
      </div>
    </header>

    <!-- Industrias y Servicios -->
    <section class="py-16 bg-white">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-center text-gray-900 mb-12">Soluciones operativas B2B</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- Beneficio 1 -->
          <div class="p-6 bg-gray-50 rounded-lg border border-gray-100">
            <h3 class="text-xl font-semibold text-blue-900 mb-3">Soporte Multiproducto</h3>
            <p class="text-gray-600">
              Espacio diseñado para lácteos, cárnicos, frutas, verduras, perecederos y productos
              congelados.
            </p>
          </div>
          <!-- Beneficio 2 -->
          <div class="p-6 bg-gray-50 rounded-lg border border-gray-100">
            <h3 class="text-xl font-semibold text-blue-900 mb-3">Control y Trazabilidad</h3>
            <p class="text-gray-600">
              Sistemas In N Out y Sitrad para administración de almacenamiento, monitoreo de
              temperatura, humedad y exactitud de existencias.
            </p>
          </div>
          <!-- Beneficio 3 -->
          <div class="p-6 bg-gray-50 rounded-lg border border-gray-100">
            <h3 class="text-xl font-semibold text-blue-900 mb-3">Proceso Integral</h3>
            <p class="text-gray-600">
              Servicio completo que incluye recepción, pesaje, almacenamiento, monitoreo, preparación
              de pedido y salida.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Galería de instalaciones -->
    <section class="py-16 bg-white">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <p class="text-sm font-semibold uppercase tracking-wider text-blue-600 mb-2">Galería</p>
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Nuestras cámaras de enfriamiento</h2>
          <p class="text-gray-600 max-w-2xl mx-auto">
            Explora las cámaras de enfriamiento que ponemos a tu servicio.
          </p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {
            gallery.map(({ slug, caption, alt }) => (
              <button
                type="button"
                class="group relative block overflow-hidden rounded-lg ring-1 ring-gray-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
                data-full={`/friganta/${slug}.webp`}
                data-caption={caption}
                aria-label={`Ampliar imagen: ${caption}`}
              >
                <img
                  src={`/friganta/${slug}-thumb.webp`}
                  alt={alt}
                  width="700"
                  height="457"
                  loading="lazy"
                  decoding="async"
                  class="aspect-[3/2] w-full object-cover transition duration-500 group-hover:scale-105"
                />
                <span
                  class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/20 to-transparent"
                  aria-hidden="true"
                />
                <span class="absolute inset-x-0 bottom-0 p-3 text-left text-sm font-semibold text-white">
                  {caption}
                </span>
              </button>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Imagen ampliada de la galería (dialog nativo: cierra con Esc y atrapa el foco) -->
    <dialog
      id="galeria-lightbox"
      class="m-auto w-[92vw] max-w-4xl border-0 bg-transparent p-0 backdrop:bg-black/80"
    >
      <figure class="relative m-0 w-fit mx-auto">
        <img
          id="galeria-lightbox-img"
          src=""
          alt=""
          class="mx-auto max-h-[80vh] w-auto rounded-lg shadow-2xl"
        />
        <figcaption id="galeria-lightbox-caption" class="mt-3 text-center text-sm text-white"></figcaption>
        <button
          type="button"
          id="galeria-lightbox-cerrar"
          class="absolute right-2 top-2 rounded-full bg-black/60 p-2 text-white ring-1 ring-white/40 transition hover:bg-black/80 focus:outline-none focus-visible:ring-2 focus-visible:ring-white"
          aria-label="Cerrar imagen ampliada"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </figure>
    </dialog>

    <!-- Formulario de Cotización Operativa -->
    <section id="cotizador" class="py-16 bg-gray-100">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white rounded-xl shadow-lg p-8 border border-gray-200">
          <h2 class="text-2xl font-bold text-gray-900 mb-2">Evalúa nuestro espacio y condiciones</h2>
          <p class="text-gray-600 mb-8">
            Comparte el tipo de producto, volumen y temperatura requerida. Nuestro equipo revisará la
            capacidad técnica en Puebla y te enviará una cotización.
          </p>

          <!-- Error de envío (oculto hasta que falle) -->
          <div
            id="form-error"
            hidden
            role="alert"
            class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6"
          >
            No pudimos enviar tu solicitud. Revisa tu conexión e inténtalo de nuevo.
          </div>

          <form id="form-cotizacion" class="space-y-6">
            <!-- Datos Comerciales -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="company" class="block text-sm font-medium text-gray-700">Empresa *</label>
                <input
                  type="text"
                  id="company"
                  name="company"
                  autocomplete="organization"
                  required
                  class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 bg-gray-50 p-2 border"
                />
              </div>
              <div>
                <label for="name" class="block text-sm font-medium text-gray-700"
                  >Nombre del contacto *</label
                >
                <input
                  type="text"
                  id="name"
                  name="name"
                  autocomplete="name"
                  required
                  class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 bg-gray-50 p-2 border"
                />
              </div>
              <div>
                <label for="email" class="block text-sm font-medium text-gray-700"
                  >Correo electrónico *</label
                >
                <input
                  type="email"
                  id="email"
                  name="email"
                  autocomplete="email"
                  required
                  class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 bg-gray-50 p-2 border"
                />
              </div>
              <div>
                <label for="phone" class="block text-sm font-medium text-gray-700"
                  >Teléfono / WhatsApp *</label
                >
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  autocomplete="tel"
                  required
                  class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 bg-gray-50 p-2 border"
                />
              </div>
            </div>

            <hr class="border-gray-200" />

            <!-- Datos Operativos (Filtro para B2B) -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="productType" class="block text-sm font-medium text-gray-700"
                  >Tipo de producto *</label
                >
                <input
                  type="text"
                  id="productType"
                  name="productType"
                  placeholder="Ej. Lácteos, Fresas, Carne de cerdo"
                  required
                  class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 bg-gray-50 p-2 border"
                />
              </div>
              <div>
                <label for="temperature" class="block text-sm font-medium text-gray-700"
                  >Temperatura requerida (°C) *</label
                >
                <input
                  type="text"
                  id="temperature"
                  name="temperature"
                  placeholder="Ej. -18°C a -20°C"
                  required
                  class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 bg-gray-50 p-2 border"
                />
              </div>
              <div>
                <label for="volume" class="block text-sm font-medium text-gray-700"
                  >Volumen / Cantidad de pallets *</label
                >
                <input
                  type="text"
                  id="volume"
                  name="volume"
                  placeholder="Ej. 10 pallets / 5 toneladas"
                  required
                  class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 bg-gray-50 p-2 border"
                />
              </div>
              <div>
                <label for="arrivalDate" class="block text-sm font-medium text-gray-700"
                  >Fecha de ingreso estimada *</label
                >
                <input
                  type="date"
                  id="arrivalDate"
                  name="arrivalDate"
                  required
                  class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 bg-gray-50 p-2 border"
                />
              </div>
              <div class="md:col-span-2">
                <label for="storageDuration" class="block text-sm font-medium text-gray-700"
                  >Duración estimada del almacenamiento *</label
                >
                <input
                  type="text"
                  id="storageDuration"
                  name="storageDuration"
                  placeholder="Ej. 3 meses, Anual, Por temporada"
                  required
                  class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 bg-gray-50 p-2 border"
                />
              </div>
              <div class="md:col-span-2">
                <label for="comments" class="block text-sm font-medium text-gray-700"
                  >Comentarios adicionales</label
                >
                <textarea
                  id="comments"
                  name="comments"
                  rows="3"
                  class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 bg-gray-50 p-2 border"></textarea>
              </div>
            </div>

            <div class="mt-6 flex items-center">
              <input
                id="privacy"
                name="privacy"
                type="checkbox"
                required
                class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded"
              />
              <label for="privacy" class="ml-2 block text-sm text-gray-600">
                Acepto el aviso de privacidad y autorizo el uso de mis datos para ser contactado.
              </label>
            </div>

            <button
              type="submit"
              class="w-full flex justify-center py-3 px-4 border border-transparent rounded-md shadow-sm text-lg font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 mt-4 disabled:opacity-70 disabled:cursor-not-allowed"
            >
              Solicitar cotización comercial
            </button>
          </form>

          <!-- Confirmación (oculta hasta que el lead se guarda) -->
          <div id="form-success" hidden role="status" class="text-center py-12">
            <div
              class="inline-flex items-center justify-center w-16 h-16 bg-green-100 rounded-full mb-4"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-8 w-8 text-green-600"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-2">¡Gracias!</h3>
            <p class="text-gray-600">
              Recibimos tu solicitud. Nuestro equipo revisará la capacidad técnica en Puebla y te
              enviará una cotización a la brevedad.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Contáctanos -->
    <section id="contacto" class="py-16 bg-white">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <p class="text-sm font-semibold uppercase tracking-wider text-blue-600 mb-2">Contáctanos</p>
          <h2 class="text-3xl font-bold text-gray-900 mb-4">¡Ponte en contacto!</h2>
          <p class="text-gray-600 max-w-2xl mx-auto">
            Podemos resolver tus necesidades: mándanos un correo, un mensaje o directamente aquí.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- Teléfono -->
          <div class="p-6 bg-gray-50 rounded-lg border border-gray-100 text-center">
            <div
              class="inline-flex items-center justify-center w-12 h-12 bg-blue-100 text-blue-700 rounded-full mb-4"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-6 w-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                ></path>
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-blue-900 mb-2">Teléfono</h3>
            <a
              href="tel:+522211847798"
              data-call-track="contacto-tarjeta"
              class="text-lg font-bold text-blue-700 hover:text-blue-900"
            >
              +52 221 184 7798
            </a>
          </div>

          <!-- Correo -->
          <div class="p-6 bg-gray-50 rounded-lg border border-gray-100 text-center">
            <div
              class="inline-flex items-center justify-center w-12 h-12 bg-blue-100 text-blue-700 rounded-full mb-4"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-6 w-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-blue-900 mb-2">Correo</h3>
            <a
              href="mailto:ventas@friganta.com"
              class="text-lg font-bold text-blue-700 hover:text-blue-900 break-all"
            >
              ventas@friganta.com
            </a>
          </div>

          <!-- Dirección -->
          <div class="p-6 bg-gray-50 rounded-lg border border-gray-100 text-center">
            <div
              class="inline-flex items-center justify-center w-12 h-12 bg-blue-100 text-blue-700 rounded-full mb-4"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-6 w-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                ></path>
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-blue-900 mb-2">Dirección</h3>
            <p class="text-gray-600">
              Km 4.5 Carretera Fábricas - Covadonga, Colonia Agrícola Ignacio Zaragoza, Puebla, Pue.
            </p>
          </div>
        </div>

        <p class="mt-8 text-center text-sm text-gray-600">
          <span class="font-semibold text-gray-700">Oficinas corporativas:</span>
          Vía Atlixcayotl 3248 Plaza W, int 211 A,B, Ex Hacienda San Martinito, San Andrés Cholula,
          Puebla.
        </p>

        <div class="mt-10 text-center">
          <a
            href="tel:+522211847798"
            data-call-track="contacto-boton"
            class="inline-flex items-center justify-center gap-3 bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-8 rounded-lg text-lg transition duration-300"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              ></path>
            </svg>
            Llamar ahora: +52 221 184 7798
          </a>
        </div>
      </div>
    </section>

    <!-- Footer Simple -->
    <footer class="bg-gray-900 text-gray-400 py-8">
      <div
        class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center md:text-left grid grid-cols-1 md:grid-cols-2 gap-8"
      >
        <div>
          <p class="font-bold text-white mb-2">Friganta</p>
          <p>Bodegas frigoríficas en Puebla para todo el centro de México.</p>
        </div>
        <div class="md:text-right">
          <p>Carretera Fábricas Covadonga km 4.5, Puebla</p>
        </div>
      </div>
    </footer>

    <script>
      // El SDK de Firestore pesa ~130 kB (gzip) y solo se necesita al enviar el
      // formulario, así que se carga bajo demanda. Además se precalienta en
      // cuanto el usuario toca algún campo, para que al enviar ya esté listo.
      type Sdk = [
        typeof import('firebase/app'),
        typeof import('firebase/firestore'),
        typeof import('../../lib/firebase-config')
      ];

      let sdk: Promise<Sdk> | null = null;
      const loadSdk = () =>
        (sdk ??= Promise.all([
          import('firebase/app'),
          import('firebase/firestore'),
          import('../../lib/firebase-config')
        ]));

      // Inicializa la app una sola vez y devuelve Firestore junto con el módulo
      // (lo comparten el formulario y el registro de clics de llamada).
      const getDb = async () => {
        const [appModule, firestore, configModule] = await loadSdk();
        const app = appModule.getApps().length
          ? appModule.getApps()[0]
          : appModule.initializeApp(configModule.firebaseConfig);
        return { db: firestore.getFirestore(app), firestore };
      };

      const form = document.getElementById('form-cotizacion') as HTMLFormElement | null;
      const successBox = document.getElementById('form-success');
      const errorBox = document.getElementById('form-error');
      const submitButton = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;

      if (form && successBox && errorBox) {
        form.addEventListener('focusin', () => void loadSdk().catch(() => {}), { once: true });

        // Resumen de una línea para la columna "Mensaje" del panel de leads.
        const summarize = (d: Record<string, string>) =>
          [
            `Producto: ${d.productType}`,
            `Temperatura: ${d.temperature}`,
            `Volumen: ${d.volume}`,
            `Ingreso estimado: ${d.arrivalDate}`,
            `Duración: ${d.storageDuration}`,
            d.comments ? `Comentarios: ${d.comments}` : ''
          ]
            .filter(Boolean)
            .join(' · ');

        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          errorBox.hidden = true;

          const originalLabel = submitButton ? submitButton.innerHTML : '';
          if (submitButton) {
            submitButton.disabled = true;
            submitButton.textContent = 'Enviando…';
          }

          const data: Record<string, string> = {};
          new FormData(form).forEach((value, key) => {
            data[key] = String(value);
          });

          try {
            const { db, firestore } = await getDb();

            await firestore.addDoc(firestore.collection(db, 'leads'), {
              // Campos que ya muestra el panel de administración
              name: data.name ?? '',
              email: data.email ?? '',
              company: data.company ?? '',
              message: summarize(data),
              // Datos operativos completos de la cotización
              phone: data.phone ?? '',
              productType: data.productType ?? '',
              temperature: data.temperature ?? '',
              volume: data.volume ?? '',
              arrivalDate: data.arrivalDate ?? '',
              storageDuration: data.storageDuration ?? '',
              comments: data.comments ?? '',
              privacyAccepted: data.privacy === 'on',
              // Origen del lead, para distinguirlo de los del formulario general
              source: 'lp-friganta',
              createdAt: firestore.serverTimestamp(),
              status: 'new'
            });

            form.hidden = true;
            successBox.hidden = false;
            successBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
          } catch (error) {
            console.error('Error al guardar el lead de Friganta:', error);
            errorBox.hidden = false;
            if (submitButton) {
              submitButton.disabled = false;
              submitButton.innerHTML = originalLabel;
            }
            errorBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        });
      }

      // --- Galería ---------------------------------------------------------
      // Cada foto abre su versión grande en un <dialog> nativo, así el cierre
      // con Esc y el manejo del foco los da el navegador (sin dependencias).
      const lightbox = document.getElementById('galeria-lightbox') as HTMLDialogElement | null;
      const lightboxImg = document.getElementById('galeria-lightbox-img') as HTMLImageElement | null;
      const lightboxCaption = document.getElementById('galeria-lightbox-caption');
      const lightboxClose = document.getElementById('galeria-lightbox-cerrar');

      if (lightbox && lightboxImg) {
        document.querySelectorAll<HTMLButtonElement>('button[data-full]').forEach((trigger) => {
          trigger.addEventListener('click', () => {
            const src = trigger.dataset.full;
            if (!src) return;
            const caption = trigger.dataset.caption ?? '';
            lightboxImg.src = src;
            lightboxImg.alt = caption;
            if (lightboxCaption) lightboxCaption.textContent = caption;
            lightbox.showModal();
          });
        });

        lightboxClose?.addEventListener('click', () => lightbox.close());

        // Clic en el fondo oscuro (fuera de la imagen) para cerrar.
        lightbox.addEventListener('click', (event) => {
          if (event.target === lightbox) lightbox.close();
        });

        // Al cerrar se suelta la imagen grande para no dejarla cargada.
        lightbox.addEventListener('close', () => {
          lightboxImg.removeAttribute('src');
          lightboxImg.alt = '';
        });
      }

      // --- Clics en los botones de llamada ---------------------------------
      // El enlace tel: nunca se bloquea: si el registro falla, la llamada sale
      // igual (no hay preventDefault). El SDK se precalienta al apuntar o
      // enfocar el botón, para que el clic ya lo encuentre listo.
      const trackCall = async (ubicacion: string) => {
        try {
          const { db, firestore } = await getDb();
          await firestore.addDoc(firestore.collection(db, 'eventos'), {
            type: 'call_click',
            source: 'lp-friganta',
            location: ubicacion,
            phone: '+522211847798',
            createdAt: firestore.serverTimestamp()
          });
        } catch (error) {
          console.error('No se pudo registrar el clic de llamada:', error);
        }
      };

      document.querySelectorAll<HTMLAnchorElement>('a[data-call-track]').forEach((link) => {
        const warmUp = () => void loadSdk().catch(() => {});
        link.addEventListener('pointerenter', warmUp, { once: true });
        link.addEventListener('focus', warmUp, { once: true });
        link.addEventListener('click', () =>
          void trackCall(link.dataset.callTrack ?? 'sin-ubicacion')
        );
      });
    </script>
  </body>
</html>
