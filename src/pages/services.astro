---
import Layout from '../layouts/Layout.astro';
import { SERVICES } from '../lib/constants';

const testimonials = [
  {
    text: "IdeasMKT nos ayudó a aumentar nuestras ventas en un 300% en 6 meses. ¡Equipo excepcional!",
    author: "Ana López",
    role: "CEO, TechStart"
  },
  {
    text: "Profesionalismo y resultados. El mejor en marketing digital.",
    author: "Carlos Ruiz",
    role: "Fundador, InnovateCo"
  }
];
---

<Layout title="Servicios - IdeasMKT">
  <section class="py-20 bg-gradient-to-br from-purple-50 via-white to-blue-50">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="text-center mb-12">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">Nuestros Servicios</h1>
        <p class="text-gray-600 max-w-2xl mx-auto">
          Soluciones integrales de marketing digital para impulsar el crecimiento de tu negocio.
        </p>
      </div>

      <div class="space-y-12">
        {SERVICES.map((service) => (
          <div key={service.id} id={service.id} class="card lg:flex items-center">
            <div class="lg:w-1/3 text-center lg:text-left mb-6 lg:mb-0">
              <div class="text-5xl mb-4">{service.icon}</div>
              <h3 class="text-2xl font-bold text-gray-900">{service.title}</h3>
              <p class="text-gray-600 mt-2">{service.subtitle}</p>
            </div>
            <div class="lg:w-2/3 lg:pl-8">
              <p class="text-gray-600 mb-4">{service.description}</p>
              <ul class="grid grid-cols-2 md:grid-cols-4 gap-2">
                {service.features.map((feature) => (
                  <li key={feature} class="flex items-center text-sm text-gray-600">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-purple-600 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-gray-50">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">Lo que dicen nuestros clientes</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        {testimonials.map((t) => (
          <div key={t.author} class="card">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-purple-600 mb-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M14.046 16.295c.718 0 1.31-.586 1.31-1.31 0-.282-.083-.54-.228-.756.364-.28.65-.664.827-1.117.347-.825.402-1.696.153-2.553-.041-.146-.324-.618-.491-.946a.336.336 0 00-.437-.156C9.81 9.724 9 10.759 9 12.295c0 1.25.727 2.285 1.777 2.778.27.12.566.222.869.222zM8.046 16.295c.718 0 1.31-.586 1.31-1.31 0-.282-.083-.54-.228-.756.364-.28.65-.664.827-1.117.347-.825.402-1.696.153-2.553-.041-.146-.324-.618-.491-.946a.336.336 0 00-.437-.156C5.81 9.724 5 10.759 5 12.295c0 1.25.727 2.285 1.777 2.778.27.12.566.222.869.222z" />
            </svg>
            <p class="text-gray-600 italic mb-4">"{t.text}"</p>
            <p class="font-semibold">— {t.author}, <span class="text-gray-500">{t.role}</span></p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
