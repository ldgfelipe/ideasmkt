{
  "hosting": {
    "site": "ideasmkt",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/src/**",
      "**/.astro/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "redirects": [
      {
        "source": "/td/zabdin-studio",
        "destination": "/td/zabdi-studio/",
        "type": 301
      },
      {
        "source": "/td/zabdin-studio/**",
        "destination": "/td/zabdi-studio/",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html|svg|json|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
